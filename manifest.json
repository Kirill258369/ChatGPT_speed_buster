{
  "manifest_version": 3,
  "name": "ChatGPT Speed Booster",
  "version": "2.0.0",
  "description": "Ускорение длинных чатов, поиск, закладки и инструменты для комфортной работы с ChatGPT.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "Ускорение ChatGPT",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "store.js",
        "tools.js",
        "panel.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}